# Google AI Studio Gemini key. Keep this file as an example only; real values stay in .env.local.
GEMINI_API_KEY=

# Free-tier friendly default model for MVP extraction and chat.
GEMINI_MODEL=gemini-2.5-flash

# Optional server-side Langflow demo agent. Do not expose these as NEXT_PUBLIC_*.
# When disabled or incomplete, GENIUS uses the local supervised fallback and still saves
# an approval-safe Workbench artifact for the investor demo.
LANGFLOW_DEMO_ENABLED=0
LANGFLOW_SERVER_URL=
LANGFLOW_FLOW_ID=genius-investor-demo-agent
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_MS=12000

# Optional Supabase backend. If these are missing, the app uses .data/genius-workspace.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_KEY=
SUPABASE_EVIDENCE_BUCKET=evidence-files

# Optional local/testing override. Keep this unset in production unless intentionally
# running a local-store smoke; when set to 1, Supabase workspace persistence is bypassed.
GENIUS_FORCE_LOCAL_STORE=

# Required in production. Generate a dedicated random value with at least 32 characters.
GENIUS_SESSION_SECRET=

# Development only. Set to 0 to require configured Supabase Auth locally.
GENIUS_ALLOW_LOCAL_AUTH=1

# Preferred secret for workspace-scoped external live-event ingestion.
# External token format: v1:<HMAC_SHA256("live-events:" + workspaceId, GENIUS_LIVE_INGEST_SECRET)>.
GENIUS_LIVE_INGEST_SECRET=

# Legacy live-event token support. Only valid when bound to exactly one workspace id.
GENIUS_LIVE_INGEST_TOKEN=
GENIUS_LIVE_INGEST_WORKSPACE_ID=

# QA only: workspace id used by production live-ingest smoke. Prefer an
# existing disposable workspace id from a test tenant.
GENIUS_LIVE_INGEST_TEST_WORKSPACE_ID=

GENIUS_WORKSPACE_ID=default

# QA only: remote production smoke target and optional account smoke credentials.
# Leave account fields empty to use guest smoke.
GENIUS_PRODUCTION_BASE_URL=
GENIUS_SMOKE_AUTH_MODE=guest
GENIUS_SMOKE_AUTH_FLOW=signin
GENIUS_SMOKE_EMAIL=
GENIUS_SMOKE_PASSWORD=

# QA only: two account-level users for production tenant isolation smoke.
# Use disposable test accounts. Set GENIUS_TENANT_AUTH_FLOW=signup for first run,
# then signin for repeat runs.
GENIUS_TENANT_AUTH_FLOW=signin
GENIUS_TENANT_A_EMAIL=
GENIUS_TENANT_A_PASSWORD=
GENIUS_TENANT_B_EMAIL=
GENIUS_TENANT_B_PASSWORD=
GENIUS_EXPECT_SUPABASE=1
